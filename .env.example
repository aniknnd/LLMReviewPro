# LLM Review Pro — Environment variables
# Copy to .env and fill in before running:
#   cp .env.example .env
# Generate SESSION_SECRET: openssl rand -base64 32

# --- Site identity (public, no secrets) ---
NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_SITE_NAME=LLM Review Pro
NEXT_PUBLIC_SITE_TAGLINE="Large Language Model news, reviews, comparisons, and tutorials"
NEXT_PUBLIC_SITE_DESCRIPTION="Daily coverage of LLMs: model releases, feature deep-dives, side-by-side comparisons, and practical tutorials for developers."
NEXT_PUBLIC_TWITTER_HANDLE=@llmreviewpro

# --- Database ---
DB_PATH=./data/blog.db
DATABASE_URL=file:./data/blog.db
BACKUP_DIR=./backups
BACKUP_KEEP=14

# --- Security (REQUIRED, >=32 chars) ---
SESSION_SECRET=change-me-openssl-rand-base64-32

# --- Admin bootstrap (used by scripts/seed.mjs and scripts/setup-admin.mjs) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# --- SEO / Analytics ---
# Google Search Console / AdSense verification token (optional)
NEXT_PUBLIC_ADSENSE_VERIFICATION=

# --- Google AdSense (monetization) ---
# Master switch. Set to "false" to disable ads globally.
NEXT_PUBLIC_ADS_ENABLED=true
# Publisher ID, e.g. pub-1234567890123456 (also used for /ads.txt)
NEXT_PUBLIC_ADSENSE_PUB_ID=pub-0000000000000000
# Optional ad unit IDs (slot numbers). Leave defaults for layout testing.
NEXT_PUBLIC_ADS_SLOT_HOME=1111111111
NEXT_PUBLIC_ADS_SLOT_HOME_2=2222222222
NEXT_PUBLIC_ADS_SLOT_BLOG=3333333333
NEXT_PUBLIC_ADS_SLOT_ARTICLE=4444444444
NEXT_PUBLIC_ADS_SLOT_SIDEBAR=5555555555
# Google-certified CMP script URL (EEA/UK/CH). When set, the built-in
# consent banner is replaced by your CMP (recommended for EEA traffic).
# Example: https://www.google.com/osd.js (or your CMP vendor's script)
NEXT_PUBLIC_GOOGLE_CMP_URL=

# --- Pagination ---
POSTS_PER_PAGE=9

# --- Node ---
NODE_ENV=production
PORT=3000

NEXT_PUBLIC_GA_ID=G-G4Y47M23QM  # Google Analytics 4 measurement ID (gtag.js)
